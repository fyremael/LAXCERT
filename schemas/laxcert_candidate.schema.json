{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.local/schemas/laxcert_candidate.schema.json",
  "title": "LAXCERT Candidate Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "laxcert_schema_version",
    "candidate_id",
    "laxforge_version",
    "scalar_ring",
    "directions",
    "fields",
    "evolution",
    "operators",
    "claims",
    "assumptions",
    "provenance"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "laxcert_schema_version": {"type": "string"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "laxforge_version": {"type": "string"},
    "laxcert_target_version": {"type": "string"},
    "scalar_ring": {"const": "rat_differential_polynomial"},
    "directions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "time"],
      "properties": {
        "space": {
          "type": "array",
          "prefixItems": [{"const": "x"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "time": {"const": "t"}
      }
    },
    "fields": {
      "type": "array",
      "items": {"enum": ["u", "p", "q"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "evolution": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"enum": ["u", "p", "q"]},
      "additionalProperties": {"$ref": "#/$defs/scalarExpr"}
    },
    "operators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L", "P"],
      "properties": {
        "L": {"$ref": "#/$defs/matrixDiffOp"},
        "P": {"$ref": "#/$defs/matrixDiffOp"},
        "U": {"$ref": "#/$defs/matrixScalar"},
        "V": {"$ref": "#/$defs/matrixScalar"}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "proof_strategy"],
        "properties": {
          "type": {
            "enum": [
              "lax_equation",
              "zero_curvature",
              "self_adjoint_L",
              "skew_adjoint_P",
              "gauge_equivalence"
            ]
          },
          "proof_strategy": {
            "enum": [
              "coefficient_certificate"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1}
      }
    },
    "prior_art": {"type": "object"},
    "gauge_reduction": {"type": "object"}
  },
  "$defs": {
    "rational": {
      "oneOf": [
        {"type": "integer"},
        {"type": "string", "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["num", "den"],
          "properties": {
            "num": {"type": "integer"},
            "den": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "scalarExpr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "const"},
            "value": {"$ref": "#/$defs/rational"},
            "display": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field", "order"],
          "properties": {
            "kind": {"const": "jet"},
            "field": {"enum": ["u", "p", "q"]},
            "order": {"type": "integer", "minimum": 0},
            "display": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "args"],
          "properties": {
            "kind": {"enum": ["add", "mul"]},
            "args": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/scalarExpr"}
            },
            "display": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "arg"],
          "properties": {
            "kind": {"const": "neg"},
            "arg": {"$ref": "#/$defs/scalarExpr"},
            "display": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "base", "exponent"],
          "properties": {
            "kind": {"const": "pow"},
            "base": {"$ref": "#/$defs/scalarExpr"},
            "exponent": {"type": "integer", "minimum": 0},
            "display": {"type": "string"}
          }
        }
      ]
    },
    "diffOpTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coeff", "order"],
      "properties": {
        "coeff": {"$ref": "#/$defs/scalarExpr"},
        "order": {"type": "integer", "minimum": 0}
      }
    },
    "diffOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms"],
      "properties": {
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/diffOpTerm"}
        }
      }
    },
    "matrixDiffOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/diffOp"}
          }
        }
      }
    },
    "matrixScalar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/scalarExpr"}
          }
        }
      }
    }
  }
}
